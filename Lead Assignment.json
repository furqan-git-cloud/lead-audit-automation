    {
      "parameters": {
        "jsCode": "// Safely check if items exist\nconst leads = items || [];\n\n// Safely access form data\nlet formName = \"Intern\";\ntry {\n  const formArray = $node[\"On form submission\"].all();\n  if (formArray && formArray.length > 0) {\n    formName = formArray[0].json.Name || \"Intern\";\n  }\n} catch (e) {\n  console.log(\"Form data not found\");\n}\n\nlet html = `<h3>Hi ${formName},</h3>\n<p>Your assigned leads are below. Please update the CRM after each call.</p>\n<table border=\"1\" cellpadding=\"8\" style=\"border-collapse: collapse; font-family: Arial, sans-serif; width: 100%; max-width: 800px;\">\n    <tr style=\"background-color: #4CAF50; color: white;\">\n        <th>Company Name</th>\n        <th>Phone</th>\n        <th>Address</th>\n        <th>Location</th>\n        <th>Website</th>\n        <th>Status</th>\n    </tr>`;\n\nif (leads.length > 0) {\n  leads.forEach(lead => {\n    const l = lead.json || lead;\n    html += `<tr>\n      <td>${l.title || '-'}</td>\n      <td>${l.phone || '-'}</td>\n      <td>${l.address || '-'}</td>\n      <td>${l.Location || '-'}</td>\n      <td>${l.url ? `<a href=\"${l.url}\" target=\"_blank\">Link</a>` : '-'}</td>\n      <td>${l.status || '-'}</td>\n    </tr>`;\n  });\n}\n\nhtml += `</table><p>Best regards,<br>Operations Team</p>`;\n\nreturn [{ json: { email_body: html } }];"
      },
